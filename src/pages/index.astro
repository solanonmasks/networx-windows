---
// The page layout. Text, images and contact details come from src/data/site.js.
import '../styles/global.css';
import {
  formEndpoint, business as b, seo, images, nav, proof, worx, promises,
  brands, projects, reviews, chips,
} from '../data/site.js';

const canonical = new URL('/', Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  name: b.name,
  url: b.url,
  telephone: b.phoneSchema,
  email: b.email,
  image: images.hero,
  logo: images.logo,
  address: {
    '@type': 'PostalAddress',
    streetAddress: b.street,
    addressLocality: b.city,
    addressRegion: b.region,
    postalCode: b.postalCode,
    addressCountry: b.country,
  },
  openingHours: b.openingHours,
  areaServed: 'Fraser Valley, BC',
  sameAs: [b.facebook, b.instagram, b.homestars],
};
---
<!doctype html>
<html lang="en-CA">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{seo.title}</title>
  <meta name="description" content={seo.description} />
  <link rel="canonical" href={canonical} />
  <meta name="theme-color" content="#0F1B2D" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={b.name} />
  <meta property="og:title" content={seo.title} />
  <meta property="og:description" content={seo.description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={images.hero} />
  <meta property="og:locale" content="en_CA" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={seo.title} />
  <meta name="twitter:description" content={seo.description} />
  <meta name="twitter:image" content={images.hero} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@500;600;700;800&family=Public+Sans:wght@400;500;600&display=swap" rel="stylesheet" />

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <!-- Turns on the entrance animations only when JavaScript runs and the visitor allows motion. -->
  <script is:inline>
    if (!(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches)) document.documentElement.classList.add('js');
  </script>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>

  <div id="top" class="utility">
    <div class="wrap">
      <span>{b.street}, {b.city} {b.region} · Showroom open {b.hoursShort}</span>
      <a href={b.phoneHref}>{b.phone}</a>
    </div>
  </div>

  <header class="header">
    <div class="wrap">
      <a href="#top" class="logo"><img src={images.logo} alt={b.name} /></a>
      <nav class="nav" aria-label="Main">
        {nav.map((n) => <a href={n.href}>{n.label}</a>)}
      </nav>
      <div class="header-actions">
        <a href="#contact" class="btn btn-amber header-cta">Free estimate</a>
        <button type="button" class="menu-btn" aria-expanded="false" aria-controls="mobile-nav">Menu</button>
      </div>
    </div>
    <nav id="mobile-nav" class="mobile-nav" aria-label="Mobile">
      <ul>
        {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        <li><a href="#contact">Free estimate</a></li>
      </ul>
    </nav>
  </header>

  <main id="main">
    <!-- Hero -->
    <section class="wrap hero">
      <div class="hero-copy">
        <p class="eyebrow" data-hero style="--d:.1s">Home improvement specialists · 30+ years</p>
        <h1 data-hero style="--d:.22s">You dream it,<br />we build it.</h1>
        <p class="hero-lede" data-hero style="--d:.34s">Windows, doors and exteriors for homeowners, contractors and property managers across the Fraser Valley. Every installation carries a lifetime warranty and our 100% leak-free guarantee.</p>
        <div class="btn-row" data-hero style="--d:.46s">
          <a href="#contact" class="btn btn-navy">Book a free estimate</a>
          <a href="#projects" class="btn btn-outline">See our projects</a>
        </div>
      </div>
      <div class="hero-frame">
        <img src={images.hero} alt={images.heroAlt} fetchpriority="high" />
        <span class="mullion mullion-v" aria-hidden="true"></span>
        <span class="mullion mullion-h" aria-hidden="true"></span>
        <span class="hero-caption">{images.heroCaption}</span>
      </div>
    </section>

    <!-- Proof strip -->
    <section class="proof" aria-label="Why Networx">
      <div class="wrap">
        {proof.map((p) => (
          <div class="proof-item" data-reveal>
            <strong>{p.t}</strong>
            <span>{p.d}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- The Worx -->
    <section id="worx" class="wrap section">
      <div class="section-head">
        <h2 class="h2" data-reveal>The Worx.</h2>
        <div class="tabs" role="tablist" aria-label="Products" data-reveal>
          {worx.map((w, i) => (
            <button type="button" class="tab" role="tab" id={`tab-${i}`} aria-controls={`panel-${i}`}
              aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? '0' : '-1'}>{w.t}</button>
          ))}
        </div>
      </div>
      {worx.map((w, i) => (
        <div class="worx-panel" role="tabpanel" id={`panel-${i}`} aria-labelledby={`tab-${i}`} hidden={i !== 0}>
          <div class="two-col worx-card">
            <div class="worx-img"><img src={w.img} alt={w.h} loading="lazy" /></div>
            <div class="worx-body">
              <h3>{w.h}</h3>
              <p>{w.p}</p>
              <ul class="tags">{w.items.map((it) => <li>{it}</li>)}</ul>
            </div>
          </div>
        </div>
      ))}
    </section>

    <!-- Installation -->
    <section id="install" class="install">
      <div class="wrap section two-col">
        <div class="stack">
          <h2 class="h2" data-reveal>Quality installation, from start to finish.</h2>
          <p class="install-lede" data-reveal>Trust and commitment are what everyone wants from a contractor. That’s what you get with Networx.</p>
        </div>
        <div class="promises">
          {promises.map((p) => (
            <div class="promise" data-reveal>
              <span class="promise-n">{p.n}</span>
              <div>
                <h3>{p.t}</h3>
                <p>{p.d}</p>
              </div>
            </div>
          ))}
          <p class="brands" data-reveal>{brands}</p>
        </div>
      </div>
    </section>

    <!-- Projects -->
    <section id="projects" class="wrap section">
      <div class="two-col projects-head">
        <h2 class="h2" data-reveal>Recent projects.</h2>
        <p data-reveal>Homes across Delta, Langley, White Rock, Cloverdale and Chilliwack, fitted with new windows, doors and siding.</p>
      </div>
      <div class="gallery">
        {projects.map((p) => (
          <figure class="project" data-reveal>
            <div class="project-img"><img class="img-zoom" src={p.src} alt={`${p.city} project`} loading="lazy" /></div>
            <figcaption>
              <strong>{p.city}</strong>
              <span>{p.d}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>

    <!-- Reviews -->
    <section id="reviews" class="reviews">
      <div class="wrap section">
        <div class="section-head">
          <h2 class="h2" data-reveal>Worth the wait.</h2>
          <a class="reviews-link" data-reveal href={b.homestars} target="_blank" rel="noopener">More reviews on HomeStars</a>
        </div>
        <div class="two-col review-grid">
          {reviews.map((r) => (
            <figure class="review" data-reveal>
              <blockquote>“{r.q}”</blockquote>
              <figcaption>{r.n}<span> · {r.c}</span></figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- Contact -->
    <section id="contact" class="wrap section two-col contact">
      <div class="stack">
        <h2 class="h2" data-reveal>Tell us about your dream project.</h2>
        <a class="contact-phone" data-reveal href={b.phoneHref}>{b.phone}</a>
        <a class="contact-email" data-reveal href={`mailto:${b.email}`}>{b.email}</a>
        <div class="contact-info" data-reveal>
          <div><strong>Showroom</strong><span>{b.street}<br />{b.city} {b.region}, {b.postalCode}</span></div>
          <div><strong>Hours</strong><span>{b.hoursLines[0]}<br />{b.hoursLines[1]}</span></div>
        </div>
      </div>
      <div>
        <form class="form" id="estimate-form" data-reveal data-endpoint={formEndpoint} method="post" action={formEndpoint || undefined}>
          <div class="form-row">
            <label class="field">Name<input name="name" autocomplete="name" required /></label>
            <label class="field">Phone<input name="phone" type="tel" autocomplete="tel" required /></label>
          </div>
          <label class="field">Email<input name="email" type="email" autocomplete="email" required /></label>
          <fieldset class="chip-group">
            <legend>I’m interested in</legend>
            <div class="chips">
              {chips.map((c) => <button type="button" class="chip" aria-pressed="false" data-value={c}>{c}</button>)}
            </div>
            <input type="hidden" name="interested_in" value="" />
          </fieldset>
          <label class="field">Project details<textarea name="details" rows="4"></textarea></label>
          <p class="form-error" role="alert" hidden>Sorry, something went wrong. Please call us at {b.phone}.</p>
          <button type="submit" class="btn btn-amber submit">Request my estimate</button>
        </form>
        <div class="thanks" id="form-thanks" role="status" tabindex="-1" hidden>Thanks. We’ll call you within one business day.</div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="wrap">
      <span class="footer-logo"><img src={images.logo} alt={b.name} loading="lazy" /></span>
      <div class="footer-social">
        <a href={b.facebook} target="_blank" rel="noopener">Facebook</a>
        <a href={b.instagram} target="_blank" rel="noopener">Instagram</a>
      </div>
      <div class="footer-legal">
        <span>© {new Date().getFullYear()} {b.legalName}</span>
        <a href="https://backpackdigitalmedia.com" target="_blank" rel="noopener">Website by Backpack Digital Media</a>
      </div>
    </div>
  </footer>

  <div class="mobile-bar">
    <a class="call" href={b.phoneHref}>Call</a>
    <a class="cta" href="#contact">Free estimate</a>
  </div>

  <script is:inline>
    (function () {
      var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var ease = 'cubic-bezier(.16,.84,.3,1)';

      // Mobile menu
      var menuBtn = document.querySelector('.menu-btn');
      var mobileNav = document.getElementById('mobile-nav');
      function setMenu(open) {
        menuBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
        menuBtn.textContent = open ? 'Close' : 'Menu';
        mobileNav.classList.toggle('is-open', open);
      }
      menuBtn.addEventListener('click', function () { setMenu(menuBtn.getAttribute('aria-expanded') !== 'true'); });
      mobileNav.addEventListener('click', function (e) { if (e.target.closest('a')) setMenu(false); });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape') setMenu(false); });

      // Scroll reveal (only for things below the fold; content stays visible without JS)
      if (!reduce && 'IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (entries) {
          var i = 0;
          entries.forEach(function (e) {
            if (!e.isIntersecting) return;
            var el = e.target, d = Math.min(i++, 5) * 0.08;
            el.style.transition = 'opacity 1s ' + ease + ' ' + d + 's, transform 1s ' + ease + ' ' + d + 's';
            el.style.opacity = 1;
            el.style.transform = 'none';
            io.unobserve(el);
          });
        }, { rootMargin: '0px 0px -8% 0px' });
        var reveals = document.querySelectorAll('[data-reveal]');
        reveals.forEach(function (el) {
          if (el.getBoundingClientRect().top < window.innerHeight) return;
          el.style.opacity = 0;
          el.style.transform = 'translateY(28px)';
          io.observe(el);
        });
        setTimeout(function () { reveals.forEach(function (el) { el.style.opacity = 1; el.style.transform = 'none'; }); }, 4000);
      }

      // The Worx tabs
      var tabs = Array.prototype.slice.call(document.querySelectorAll('[role="tab"]'));
      function selectTab(tab, focus) {
        tabs.forEach(function (t) {
          var on = t === tab;
          t.setAttribute('aria-selected', on ? 'true' : 'false');
          t.tabIndex = on ? 0 : -1;
          var panel = document.getElementById(t.getAttribute('aria-controls'));
          panel.hidden = !on;
          panel.classList.toggle('is-entering', on);
        });
        if (focus) tab.focus();
      }
      tabs.forEach(function (tab, i) {
        tab.addEventListener('click', function () { selectTab(tab); });
        tab.addEventListener('keydown', function (e) {
          var next = null;
          if (e.key === 'ArrowRight') next = tabs[(i + 1) % tabs.length];
          if (e.key === 'ArrowLeft') next = tabs[(i - 1 + tabs.length) % tabs.length];
          if (e.key === 'Home') next = tabs[0];
          if (e.key === 'End') next = tabs[tabs.length - 1];
          if (next) { e.preventDefault(); selectTab(next, true); }
        });
      });

      // Form chips
      var form = document.getElementById('estimate-form');
      var hidden = form.querySelector('input[name="interested_in"]');
      var chipBtns = form.querySelectorAll('.chip');
      chipBtns.forEach(function (c) {
        c.addEventListener('click', function () {
          c.setAttribute('aria-pressed', c.getAttribute('aria-pressed') === 'true' ? 'false' : 'true');
          var picks = [];
          chipBtns.forEach(function (x) { if (x.getAttribute('aria-pressed') === 'true') picks.push(x.dataset.value); });
          hidden.value = picks.join(', ');
        });
      });

      // Form submit
      var thanks = document.getElementById('form-thanks');
      var errorMsg = form.querySelector('.form-error');
      var submitBtn = form.querySelector('[type="submit"]');
      function showThanks() { form.hidden = true; thanks.hidden = false; thanks.focus(); }
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var endpoint = form.dataset.endpoint;
        errorMsg.hidden = true;
        if (!endpoint) { showThanks(); return; }
        submitBtn.disabled = true;
        fetch(endpoint, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } })
          .then(function (res) { if (!res.ok) throw new Error('Bad response'); showThanks(); })
          .catch(function () { errorMsg.hidden = false; })
          .finally(function () { submitBtn.disabled = false; });
      });
    })();
  </script>
</body>
</html>
